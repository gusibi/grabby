---
import BaseLayout from '../layouts/BaseLayout.astro';

function hlJson(json: string) {
  return json.replace(
    /("(?:[^"\\]|\\.)*")\s*:/g,
    '<span class="text-[#7ee787]">$1</span>:'
  ).replace(
    /:\s*("(?:[^"\\]|\\.)*")/g,
    ': <span class="text-[#a5d6ff]">$1</span>'
  ).replace(
    /:\s*(true|false)/g,
    ': <span class="text-[#ff7b72]">$1</span>'
  ).replace(
    /:\s*(\d+)/g,
    ': <span class="text-[#79c0ff]">$1</span>'
  );
}

const heroReq = hlJson(`{
  "url": "https://example.com",
  "browser": "chrome"
}`);

const heroResp = hlJson(`{
  "success": true,
  "title": "Example Domain",
  "markdown": "# Example Domain\\nThis domain is for use..."
}`);

const jsonLdApp = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Grabby",
  "description": "Grabby is a local-first content desk: capture any page to clean Markdown with a real Chrome browser, collect RSS feeds and platforms, then let AI score, summarize and turn everything into a daily briefing. Includes MCP support and local SQLite storage.",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "macOS, Windows, Linux",
  "url": "https://grabby.eztoolab.com",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "featureList": [
    "Real-browser web capture to clean Markdown",
    "RSS and platform feed collection",
    "AI scoring, categorization and summaries",
    "AI morning / evening daily briefing",
    "HTTP API, MCP tools and WebSocket protocol",
    "Local SQLite storage"
  ],
  "author": { "@type": "Person", "name": "gusibi", "url": "https://github.com/gusibi" }
});

const jsonLdSite = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Grabby",
  "url": "https://grabby.eztoolab.com",
  "description": "Grabby — web capture, RSS and AI reading in one local-first desktop app"
});
---

<BaseLayout page="home">
  <main>
    <!-- Hero -->
    <section class="pt-40 pb-16 relative overflow-hidden">
      <div class="absolute inset-0 pointer-events-none">
        <div
          class="absolute -top-1/2 -left-[20%] w-[140%] h-[200%] bg-[radial-gradient(ellipse_at_30%_20%,rgba(99,102,241,0.12)_0%,transparent_50%),radial-gradient(ellipse_at_70%_80%,rgba(129,140,248,0.06)_0%,transparent_50%)]"
        ></div>
      </div>
      <div class="max-w-7xl mx-auto px-8 relative z-10">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <div
              class="inline-flex items-center gap-2 px-4 py-1.5 bg-white dark:bg-[#161616] border border-bord dark:border-[#2a2a2a] rounded-full font-mono text-xs text-accent mb-6"
            >
              <span class="w-1.5 h-1.5 bg-accent rounded-full animate-pulse"></span>
              <span data-i18n="home.badge">本地优先 · Chrome 扩展 + 桌面 App + AI 阅读</span>
            </div>
            <h1
              class="font-mono font-semibold text-5xl sm:text-6xl leading-none tracking-tight mb-6"
            >
              <span class="text-accent" data-i18n="home.heroLine1">抓网页</span><br />
              <span data-i18n="home.heroLine2">收 RSS 和平台</span><br />
              <span class="text-mute dark:text-[#888]" data-i18n="home.heroLine3">AI 帮你读完。</span>
            </h1>
            <p
              class="text-lg text-mute dark:text-[#888] max-w-xl mb-10 leading-relaxed"
              data-i18n="home.heroDesc"
            >
              Grabby 用真实 Chrome 浏览器抓取任意网页，保留登录态；也能订阅 RSS、采集 X / Reddit / 小红书等平台内容。
              AI 负责评分、分类、摘要和日报，数据默认只留在本机。
            </p>
            <div class="flex gap-4 flex-wrap">
              <a
                href="https://github.com/gusibi/grabby/releases"
                class="inline-flex items-center gap-2 px-8 py-3.5 bg-accent text-white rounded-lg font-mono font-semibold hover:bg-accent-hover hover:-translate-y-0.5 hover:shadow-[0_8px_30px_rgba(99,102,241,0.25)] transition-all"
                target="_blank" rel="noopener"
                data-i18n="home.download"
              >
                <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                  <polyline points="7 10 12 15 17 10" />
                  <line x1="12" y1="15" x2="12" y2="3" />
                </svg>
                下载桌面 App
              </a>
              <a
                href="/setup"
                class="inline-flex items-center gap-2 px-8 py-3.5 bg-white dark:bg-[#161616] border border-bord dark:border-[#2a2a2a] rounded-lg font-mono font-semibold hover:border-accent hover:-translate-y-0.5 transition-all"
                data-i18n="home.setup"
              >
                使用指南 →
              </a>
            </div>
          </div>
          <div>
            <div
              class="rounded-2xl overflow-hidden border border-[#30363d] bg-[#0d1117] shadow-sm"
            >
              <div class="p-6 font-mono text-sm">
                <div class="flex items-center gap-2 mb-4 pb-4 border-b border-[#30363d]">
                  <span class="text-[#ff7b72]">POST</span>
                  <span class="text-[#8b949e]">/api/extract</span>
                </div>
                <div class="text-sm leading-relaxed">
                  <pre class="!p-0 !border-0 !bg-transparent !shadow-none"><code set:html={heroReq} /></pre>
                </div>
                <div class="mt-4 flex items-center gap-2 text-[#3fb950]">
                  → 200 OK
                </div>
                <div class="mt-2 text-sm leading-relaxed">
                  <pre class="!p-0 !border-0 !bg-transparent !shadow-none"><code set:html={heroResp} /></pre>
                </div>
              </div>
            </div>
            <p
              class="mt-3 text-center font-mono text-[11px] text-mute-dim dark:text-[#666]"
              data-i18n="home.apiCaption"
            >
              同一个服务，也是抓取 API 与 MCP 工具
